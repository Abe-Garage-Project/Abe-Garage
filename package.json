{
  "name": "abe-garage",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "check:structure": "node scripts/verify-project.cjs",
    "test": "npm test --workspace backend",
    "check": "npm run check:structure && npm test && npm run build",
    "seed:admin": "npm run seed:admin --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
